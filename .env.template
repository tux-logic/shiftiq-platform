# Database Configuration Template (PostgreSQL)
DATABASE_URL=your_database_host
DATABASE_PORT=5432
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_URI=postgres://your_user:your_password@your_host:5432/your_database?sslmode=require

# Cloudinary Credentials Template
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Mercado Pago Integration Template
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret

# Factos Integration (Electronic Invoicing / SUNAT)
FACTOS_API_URL=https://factos-reva.onrender.com
FACTOS_API_KEY=your_factos_api_key

# EmailVerify Integration
EMAILVERIFY_API_KEY=your_emailverify_api_key
EMAILVERIFY_API_URL=https://app.emailverify.io/api/v1/validate

# Brevo Integration (Transactional Emails)
BREVO_API_KEY=your_brevo_api_key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_EMAIL=no-reply@shiftiq.com
BREVO_SENDER_NAME=ShiftIQ Platform

# Factiliza Integration (RENIEC, SUNAT, Migraciones)
FACTILIZA_API_TOKEN=your_factiliza_api_token
FACTILIZA_API_URL=https://api.factiliza.com

# Security & Authentication
JWT_SECRET=your_jwt_secret_key

# Mail / SMTP Configuration
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password

# Reverse proxy (client IP resolution for the Mercado Pago rate limiter).
# Only required when the edge proxy has a public IP; the default trusts loopback and
# private ranges (RFC1918, RFC6598). Use a CIDR or a regex.
# SERVER_TOMCAT_REMOTEIP_INTERNALPROXIES=203.0.113.10/32
